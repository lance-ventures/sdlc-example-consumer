{
  "name": "sdlc-example-consumer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.11.x"
  },
  "sdlcSystemVersion": "1.0.0",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "visual": "node scripts/visual-check.mjs",
    "smoke": "node scripts/preview-smoke.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "maintenance": "node scripts/maintenance-check.mjs",
    "check": "npm run build && npm test && npm run visual && npm run docs:check && npm run smoke && npm run maintenance"
  },
  "devDependencies": {
    "@lance-ventures/sdlc": "2.1.0",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  }
}
